        {
            "vulnerability_id": "SFTY-20260416-21500",
            "package_name": "mako",
            "ignored": {},
            "ignored_reason": null,
            "ignored_expires": null,
            "vulnerable_spec": [
                "<=1.3.10"
            ],
            "all_vulnerable_specs": [

# Trading Bot Environment Configuration

# Application Settings
ENVIRONMENT=production
LOG_LEVEL=INFO

# Authentication
JWT_SECRET_KEY=your-jwt-secret-key-here-change-this-in-production

# Database Configuration (SQLite)
DATABASE_PATH=/app/data/trading_bot.db

# PostgreSQL Configuration (Optional - for production use)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=trading_bot
POSTGRES_USER=trading_user
POSTGRES_PASSWORD=your-postgres-password-here

# Redis Configuration (Optional - for caching)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password-or-leave-empty

# Exchange API Credentials
# For testnet/development, these can be optional
# For production trading, you'll need actual exchange credentials
API_KEY=your-exchange-api-key
API_SECRET=your-exchange-api-secret
TESTNET=true

# Agent Wallet Configuration
# Used for Solana/blockchain trading
AGENT_WALLET_PRIVATE_KEY=your-agent-wallet-private-key
ACCOUNT_PUBLIC_KEY=your-account-public-key

# Monitoring
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_URL=http://grafana:3000
GRAFANA_PASSWORD=change-this-password-in-production

# Alerting (Optional)
# Configure these if you want email/webhook alerts
ALERT_WEBHOOK_URL=https://hooks.slack.com/your-webhook-url
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-email-app-password

# External Services (Optional)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Feature Flags
ENABLE_RISK_MANAGEMENT=true
ENABLE_REAL_TIME_DATA=true
ENABLE_AUTO_TRADING=false
ENABLE_BACKTESTING=false

# Performance Settings
MAX_CONNECTIONS=100
REQUEST_TIMEOUT=30
CACHE_TTL=300

# Security
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
MASTER_ENCRYPTION_KEY=your-32-byte-master-encryption-key-here
ENCRYPTION_SALT=your-unique-salt-for-pbkdf2-key-derivation

# Pacifica.fi Subaccount Configuration
# Main account credentials (used for all subaccounts)
AGENT_WALLET_PRIVATE_KEY=your-agent-wallet-private-key-here
ACCOUNT_PUBLIC_KEY=your-main-account-public-key-here

# Subaccount Management
# Default subaccount to use for trading (discovered via discover_subaccounts.py)
DEFAULT_SUBACCOUNT_ID=sub_12345
# Enable multi-subaccount support
ENABLE_MULTI_SUBACCOUNT=true
# Subaccount name prefix for new subaccounts
SUBACCOUNT_NAME_PREFIX=TradingBot

# Legacy Configuration (backwards compatibility)
AGENT_PRIVATE_KEY=your-agent-private-key-here
SUBACCOUNT_NAME=TradingBot_SubAccount

# Agent System Configuration
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Live SQLite database at the repo root (auto-created; mutates on every run).
/trading_bot.db
# Per-machine Claude Code permission overrides; never shared.
.claude/settings.local.json
# Candle/funding store: multi-year, expensive to re-download, never committed.
# Broadened from the data/ dir alone - no parquet anywhere is a source artefact.
*.parquet
trading_bot_v2/optimization/optimization_studies.db
trading_bot_v2/.kline_cache/
# Default output of `run_backtest.py --report` at the repo root. Root-anchored
# on purpose: backtesting/reports/html/backtest_report.html is a tracked
# reference artefact and must keep showing up.
/backtest_report.html
# Default output of `run_harness.py` (JSON + text report per run).
/backtesting/reports/harness/
# Agent worktrees are disposable copies of the tree (currently ~1.5 GB).
# Blanket rule replaces the six per-worktree entries that preceded it.
.claude/worktrees/
.env.backup*
.env.bak*

# Copy to /etc/bot3/bot.env on the VPS; never add actual keys to Git.
# Generate a unique API_TOKEN with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
# Testnet wallet only. Leave blank for the initial stopped service inspection.
AGENT_WALLET_PRIVATE_KEY=
ACCOUNT_PUBLIC_KEY=
LOG_LEVEL=INFO
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30

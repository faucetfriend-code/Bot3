# Copy to /etc/bot3/bot.env on the VPS; never add actual keys to Git.
# Bot3 requires at least one month of actual paper testing before live review.
# No continuous simulated-paper runtime is wired here. TESTNET is not paper mode.
# Compose also hardcodes these defaults; do not override it for mainnet.
TESTNET=true
ENABLE_AUTO_TRADING=false
# Generate a unique API_TOKEN with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
# Testnet wallet only. Leave blank for the initial stopped service inspection.
AGENT_WALLET_PRIVATE_KEY=
ACCOUNT_PUBLIC_KEY=
LOG_LEVEL=INFO
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30

# External service environment; never copy workstation .env or account keys.
EXCHANGE=pacifica
PAPER_MODE=true
PACIFICA_TESTNET=true
PACIFICA_ACCOUNT_PUBLIC_KEY=
PACIFICA_AGENT_PRIVATE_KEY=
FOLLOWBOT_SOURCE=/var/lib/discord-follow/app
# Set true only after an operator verifies the Linux browser's Discord login.
FOLLOWBOT_SESSION_CONFIRMED=false
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5050
# Include /v1 if required by the OpenAI-compatible server. No public fallback.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
LOCAL_VISION_MODEL=

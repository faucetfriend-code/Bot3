Python# strategies/grid_trading.py\par
from typing import Optional, Dict\par
from loguru import logger\par
# ... existing imports ...\par
from core_logic.indicators import calculate_atr\par
\par
class GridTradingStrategy(BaseStrategy):\par
    def __init__(self,\par
                 grid_levels: int = 8,\par
                 base_spacing_multiplier: float = 1.2,     # k in spacing = k \f0\'d7 ATR\par
                 min_spacing_pct: float = 0.003,           # floor 0.3%\par
                 max_spacing_pct: float = 0.08,            # cap 8%\par
                 atr_period: int = 14,\par
                 atr_timeframe: str = "5m",                # or "15m" for smoother\par
                 refresh_interval_min: int = 30,           # how often to re-eval spacing\par
                 **kwargs):\par
        super().__init__()\par
        self.strategy_type = StrategyType.GRID_TRADING\par
        self.grid_levels = grid_levels\par
        self.base_k = base_spacing_multiplier\par
        self.min_spacing_pct = min_spacing_pct\par
        self.max_spacing_pct = max_spacing_pct\par
        self.atr_period = atr_period\par
        self.atr_tf = atr_timeframe\par
        self.last_spacing_refresh = \{\}  # symbol \f1\u8594?\f0  last refresh timestamp\par
        self.current_spacing = \{\}       # symbol \f1\u8594?\f0  current spacing value (absolute or %)\par
        # ... existing params (emergency_stop_pct, adx_threshold, etc.)\par
\par
    def get_dynamic_spacing(self, symbol: str, market_data: Dict[str, Any]) -> float:\par
        """\par
        Compute current grid spacing (as decimal, e.g. 0.015 = 1.5%)\par
        Uses latest ATR from requested timeframe\par
        """\par
        if symbol not in self.last_spacing_refresh or \\\par
           (datetime.now() - self.last_spacing_refresh.get(symbol, datetime.min)).total_seconds() > (self.refresh_interval_min * 60):\par
            \par
            df = market_data.get(self.atr_tf)\par
            if df is None or len(df) < self.atr_period + 10:\par
                logger.warning(f"Insufficient \{self.atr_tf\} data for \{symbol\} - using fallback spacing")\par
                spacing = 0.015  # 1.5% fallback\par
            else:\par
                atr_values = calculate_atr(df['high'], df['low'], df['close'], period=self.atr_period)\par
                current_atr = atr_values[-1]\par
                current_price = df['close'].iloc[-1]\par
                \par
                # ATR as % of price\par
                atr_pct = current_atr / current_price if current_price > 0 else 0.01\par
                \par
                # Apply multiplier & clamps\par
                spacing_pct = self.base_k * atr_pct\par
                spacing_pct = max(self.min_spacing_pct, min(self.max_spacing_pct, spacing_pct))\par
                \par
                logger.debug(f"\{symbol\} dynamic spacing: \{spacing_pct:.3%\} (ATR $\{current_atr:.4f\} \f1\u8594?\f0  \{atr_pct:.3%\} \'d7 k=\{self.base_k\})")\par
                self.current_spacing[symbol] = spacing_pct\par
                self.last_spacing_refresh[symbol] = datetime.now()\par
        \par
        return self.current_spacing.get(symbol, 0.015)  # default fallback\par
\par
    def generate_signal(self, symbol: str, timeframe_data: Dict[str, Any], **kwargs) -> Optional[Signal]:\par
        # ... existing regime / ADX checks ...\par
\par
        # Get dynamic spacing instead of fixed\par
        spacing = self.get_dynamic_spacing(symbol, timeframe_data)\par
        \par
        # Use spacing to define levels (example arithmetic grid)\par
        current_price = timeframe_data.get("1m", timeframe_data.get("5m"))['close'].iloc[-1]\par
        grid_center = current_price  # or VWAP / EMA if you want anchored\par
        \par
        proposed_levels = []\par
        for i in range(1, self.grid_levels // 2 + 1):\par
            buy_price = grid_center * (1 - i * spacing)\par
            sell_price = grid_center * (1 + i * spacing)\par
            proposed_levels.append(\{"side": "buy", "price": buy_price, "level": -i\})\par
            proposed_levels.append(\{"side": "sell", "price": sell_price, "level": i\})\par
\par
        # Build Signal with dynamic info\par
        signal = Signal(\par
            strategy=self.strategy_type,\par
            asset=symbol,\par
            # ... other fields ...\par
            notes=f"Dynamic spacing \{spacing:.3%\} (k=\{self.base_k\} \'d7 ATR%) | levels centered @ $\{grid_center:.4f\}",\par
            # pass proposed_levels or spacing in indicators dict if needed\par
            indicators=\{"grid_spacing": spacing, "atr_pct": ...\}\par
        )\par
        return signal\par

class GridLifecycleManager:\par
    # ... existing code ...\par
\par
    def get_grid_center(self, symbol: str) -> Optional[float]:\par
        """Return the current reference center price of the active grid."""\par
        if not self.has_active_grid(symbol):\par
            return None\par
        grid = self._grids[symbol]\par
        # Option A: use average of all placed limit prices (most common)\par
        if "placed_orders" in grid and grid["placed_orders"]:\par
            prices = [o["price"] for o in grid["placed_orders"].values()]\par
            return sum(prices) / len(prices)\par
        # Option B: fallback to initial center or last known mid\par
        return grid.get("center_price", None)  # you may need to store this at creation\par
\par
    def get_last_refresh_time(self, symbol: str) -> Optional[datetime]:\par
        """Track when grid was last recentered / refreshed."""\par
        if symbol not in self._grids:\par
            return None\par
        return self._grids[symbol].get("last_refresh", None)\par
\par
    def recenter_grid(self, symbol: str, new_center: float, reason: str = "signal_refresh"):\par
        """\par
        Soft recenter: shift UNFILLED limit orders toward new center price.\par
        Does NOT touch filled positions.\par
        """\par
        if not self.has_active_grid(symbol):\par
            logger.warning(f"Cannot recenter - no active grid for \{symbol\}")\par
            return False\par
\par
        grid = self._grids[symbol]\par
        current_center = self.get_grid_center(symbol)\par
        if current_center is None:\par
            logger.error(f"Cannot recenter \{symbol\} - no current center price")\par
            return False\par
\par
        # Safety: enforce minimum time between refreshes (e.g. 45 minutes)\par
        last_refresh = self.get_last_refresh_time(symbol)\par
        if last_refresh and (datetime.now() - last_refresh).total_seconds() < 2700:  # 45 min\par
            logger.info(f"Refresh skipped for \{symbol\} - too soon since last (\{last_refresh\})")\par
            return False\par
\par
        drift_abs = abs(new_center - current_center)\par
        logger.info(f"Recentering \{symbol\} | old center $\{current_center:.4f\} \f1\u8594?\f0  new $\{new_center:.4f\} "\par
                    f"(drift $\{drift_abs:.4f\}) - reason: \{reason\}")\par
\par
        try:\par
            # 1. Lock / critical section (use existing _data_lock if shared)\par
            with self._data_lock:  # assuming you expose or pass lock from TradingBot\par
\par
                # 2. Get current unfilled orders\par
                unfilled_orders = \{\}  # order_id \f1\u8594?\f0  \{price, side, quantity, ...\}\par
                for order_id, order_info in grid.get("placed_orders", \{\}).items():\par
                    if order_info.get("status") == "open":  # or check via API if needed\par
                        unfilled_orders[order_id] = order_info\par
\par
                if not unfilled_orders:\par
                    logger.info(f"No unfilled orders to recenter for \{symbol\}")\par
                    # Still update metadata\par
                    grid["center_price"] = new_center\par
                    grid["last_refresh"] = datetime.now()\par
                    return True\par
\par
                # 3. Calculate shift delta\par
                delta = new_center - current_center\par
\par
                # 4. For each unfilled order: cancel \f1\u8594?\f0  place new at adjusted price\par
                for order_id, info in unfilled_orders.items():\par
                    old_price = info["price"]\par
                    new_price = old_price + delta\par
\par
                    # Optional: clamp to prevent insane moves\par
                    if abs(new_price - old_price) / old_price > 0.08:  # >8% single jump\par
                        logger.warning(f"Price shift too large for \{symbol\} order \{order_id\} "\par
                                       f"- skipping this leg")\par
                        continue\par
\par
                    side = info["side"]\par
                    quantity = info["quantity"]\par
\par
                    # Cancel old\par
                    try:\par
                        self.client.cancel_order(symbol, order_id)\par
                        logger.debug(f"Cancelled old order \{order_id\} @ $\{old_price:.4f\}")\par
                    except Exception as e:\par
                        logger.error(f"Cancel failed for \{order_id\}: \{e\}")\par
                        continue  # don't place new if cancel failed\par
\par
                    # Place new\par
                    try:\par
                        new_order = self.client.place_order(\par
                            symbol=symbol,\par
                            side=side,\par
                            quantity=quantity,\par
                            price=new_price,\par
                            type="limit"\par
                        )\par
                        new_order_id = new_order.get("id")\par
                        logger.info(f"Replaced order \{order_id\} \f1\u8594?\f0  \{new_order_id\} "\par
                                    f"@ $\{new_price:.4f\} (\{side\})")\par
\par
                        # Update internal tracking\par
                        grid["placed_orders"][new_order_id] = \{\par
                            **info,\par
                            "order_id": new_order_id,\par
                            "price": new_price,\par
                            "placed_at": datetime.now()\par
                        \}\par
                        del grid["placed_orders"][order_id]  # remove old\par
\par
                    except Exception as e:\par
                        logger.error(f"Replace failed for \{symbol\} \{side\} \{quantity\}: \{e\}")\par
\par
                # 5. Update grid metadata\par
                grid["center_price"] = new_center\par
                grid["last_refresh"] = datetime.now()\par
                grid["last_refresh_reason"] = reason\par
\par
                logger.info(f"Grid recenter completed for \{symbol\} - \{len(unfilled_orders)\} legs adjusted")\par
\par
                return True\par
\par
        except Exception as e:\par
            logger.critical(f"Recentering FAILED for \{symbol\}: \{e\}")\par
            # Optional: emergency flatten if partial failure?\par
            return False\par
